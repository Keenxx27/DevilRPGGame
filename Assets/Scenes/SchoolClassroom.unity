--- !u!114 &615758414
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 615758412}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7c4c9060f30a4f678e1f136202408017, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueController: {fileID: 2150000000}
  openingBroadcast: {fileID: 2150000010}
  searchIntroPages:
  - speaker: "\u4E3B\u89D2"
    text: "\u80AF\u5B9A\u4E0D\u662F\u653E\u5728\u522B\u7684\u540C\u5B66\u7684\u8BFE\u684C\u3002"
  storageCabinetPages:
  - speaker: "\u4E3B\u89D2"
    text: "\u50A8\u7269\u67DC\u91CC\u6CA1\u6709\u3002\u770B\u6765\u4E5F\u6CA1\u4EBA\u628A\u5B83\u968F\u624B\u585E\u8FDB\u6765\u3002"
  podiumPages:
  - speaker: "\u4E3B\u89D2"
    text: "\u6559\u6388\u7684\u684C\u5B50\u4E0A\u4E5F\u6CA1\u6709\u3002\u6700\u597D\u522B\u5728\u8FD9\u91CC\u4E71\u7FFB\u3002"
  teacherDeskPages:
  - speaker: "\u4E3B\u89D2"
    text: "\u8BB2\u53F0\u4E0B\u9762\u7A7A\u7A7A\u7684\u3002"
  blackboardPages:
  - speaker: "\u4E3B\u89D2"
    text: "\u9ED1\u677F\u9644\u8FD1\u4E5F\u6CA1\u6709\u3002\u603B\u4E0D\u53EF\u80FD\u5939\u5728\u7C89\u7B14\u69FD\u91CC\u5427\u3002"
  firstFlowerpotPages:
  - speaker: "\u4E3B\u89D2"
    text: "\u82B1\u76C6\u4E0B\u9762\u2026\u2026\u597D\u50CF\u538B\u7740\u4EC0\u4E48\u3002"
  - speaker: "\u4E3B\u89D2"
    text: "\u662F\u6211\u7684\u501F\u4E66\u5361\u3002"
  - speaker: "\u4E3B\u89D2"
    text: "\u82B1\u76C6\u7EB9\u4E1D\u4E0D\u52A8\u3002\u771F\u591F\u6C89\u7684\u3002"
  - speaker: "\u4E3B\u89D2"
    text: "\u628A\u8FD9\u79CD\u4E1C\u897F\u85CF\u5728\u8FD9\u91CC\uFF0C\u5F88\u597D\u73A9\u5417\uFF1F"
  - speaker: "\u4E3B\u89D2"
    text: "\u5C31\u56E0\u4E3A\u6211\u8138\u4E0A\u7684\u75D5\u8FF9\uFF0C\u4ED6\u4EEC\u5C31\u89C9\u5F97\u53EF\u4EE5\u968F\u4FBF\u6B3A\u8D1F\u6211\u3002"
  - speaker: "\u4E3B\u89D2"
    text: "\u751F\u6C14\u53C8\u80FD\u600E\u4E48\u6837\u2026\u2026\u6211\u603B\u4E0D\u80FD\u5728\u6559\u5BA4\u91CC\u548C\u6240\u6709\u4EBA\u6253\u4E00\u67B6\u3002"
  - speaker: "\u4E3B\u89D2"
    text: "\u5F97\u627E\u4E2A\u591F\u7ED3\u5B9E\u7684\u4E1C\u897F\uFF0C\u628A\u82B1\u76C6\u7838\u5F00\u3002"
  repeatFlowerpotPages:
  - speaker: "\u4E3B\u89D2"
    text: "\u8FD8\u662F\u63A8\u4E0D\u52A8\u3002\u5F97\u627E\u4E2A\u4E1C\u897F\u628A\u5B83\u7838\u5F00\u3002"
  flowerpotBrokenPages:
  - speaker: "\u4E3B\u89D2"
    text: "\u788E\u4E86\u3002\u501F\u4E66\u5361\u5C31\u5728\u4E0B\u9762\u3002"
  cardPickedUpPages:
  - speaker: "\u4E3B\u89D2"
    text: "\u7EC8\u4E8E\u62FF\u56DE\u6765\u4E86\u3002\u8BE5\u53BB\u56FE\u4E66\u9986\u4E86\u3002"
