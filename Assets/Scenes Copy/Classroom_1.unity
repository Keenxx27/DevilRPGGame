--- !u!114 &2150000010
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 35893605}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7c4c9060f30a4f678e1f136202408012, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  controller: {fileID: 2150000000}
  pages:
  - speaker: "\u6559\u6388"
    text: "\u6240\u4EE5\u540C\u5B66\u4EEC\u8981\u660E\u786E\uFF0C"
  - speaker: "\u6559\u6388"
    text: "\u6076\u9B54\u662F\u5F52\u589F\u4FB5\u8680\u5177\u8C61\u5316\u7684\u3001\u5145\u6EE1\u653B\u51FB\u6027\u7684\u526F\u4EA7\u7269\u3002"
  - speaker: "\u6559\u6388"
    text: "\u6076\u9B54\u730E\u4EBA\u7684\u4EFB\u52A1\uFF0C\u5C31\u662F\u50CF\u6E05\u9664\u764C\u7EC6\u80DE\u4E00\u6837\uFF0C\u5C06\u5B83\u4EEC\u4ECE\u5730\u7403\u7684\u808C\u4F53\u4E0A\u5F7B\u5E95\u6E05\u9664\u3002"
  - speaker: "\u4E3B\u89D2"
    text: "\uFF08\u5DE6\u8138\u88AB\u5F52\u589F\u4FB5\u8680\u7684\u75D5\u8FF9\u2026\u2026\u6B63\u5728\u53D1\u70ED\u3001\u707C\u75DB\u3002\uFF09"
  - speaker: "\u4E3B\u89D2"
    text: "\u5982\u679C\u5B83\u4EEC\u53EA\u662F\u52A8\u7269\u3002"
  - speaker: "\u4E3B\u89D2"
    text: "\u5982\u679C\u5B83\u4EEC\u4E2D\uFF0C\u6709\u6BD4\u52A8\u7269\u66F4\u590D\u6742\u7684\u5B58\u5728\u3002"
  - speaker: "\u4E3B\u89D2"
    text: "\u6211\u4EEC\u5230\u5E95\u5728\u505A\u4EC0\u4E48\uFF1F"
  - speaker: "\u4E3B\u89D2"
    text: "\u4E5F\u8BB8\u6211\u8BE5\u53BB\u56FE\u4E66\u9986\u770B\u770B......"
  - speaker: "\u4E3B\u89D2"
    text: "\u4E0D\u77E5\u9053\u6211\u7684\u501F\u4E66\u5361\u53BB\u54EA\u91CC\u4E86\uFF0C"
  - speaker: "\u4E3B\u89D2"
    text: "\u53EF\u80FD\u662F\u88AB\u54EA\u4E2A\u5BB6\u4F19\u85CF\u8D77\u6765\u4E86\u3002"
